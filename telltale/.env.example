# TellTale configuration — every variable is optional.
PORT=4173
HOST=0.0.0.0
NODE_ENV=production

# Where scans.json lives. Point this at a persistent volume in production.
# Defaults to ./data
DATA_DIR=./data

# Set to "false" on a public deployment if you don't want submitted text
# persisted to disk. Reports and exports still work; history stays empty.
STORE_SCANS=true
